# ==========================================
# JobShield AI - Root .gitignore
# ==========================================

# ------------------------------------------
# Environment & Secret files
# ------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example
!frontend/.env.example

# ------------------------------------------
# Python & Django
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec

# Virtual Environments
venv/
venv*/
env/
env*/
ENV/
.venv/
.env/

# Django specifics
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# ------------------------------------------
# Node / Frontend (React / Vite)
# ------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
frontend/dist/
frontend/dist-ssr/
dist/
dist-ssr/
*.local

# ------------------------------------------
# Machine Learning & Data
# ------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*.ipynb_checkpoints
.pytest_cache/
.coverage
htmlcov/
.tox/

# ------------------------------------------
# IDE & Editor files
# ------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ------------------------------------------
# OS generated files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------
# Temporary & Backup files
# ------------------------------------------
* - Copy/
* - Copy
*.bak
*.tmp
*.temp

# Production secrets and settings backups
backend/.env.production
backend/config/settings.py.backup*
