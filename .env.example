# ==========================================
# JobShield AI - Environment Configuration
# ==========================================

# Backend Settings
SECRET_KEY=jobshield-super-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Settings
# Set DB_ENGINE=postgres and supply variables for PostgreSQL, or leave DB_ENGINE=sqlite for local SQLite
DB_ENGINE=sqlite
POSTGRES_DB=jobshield
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Frontend Settings
VITE_API_URL=http://localhost:8000/api
